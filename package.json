{
  "name": "dsh-hub-status",
  "version": "0.2.1",
  "description": "Two right-sidebar tabs for DeepSeek Harness: Hub status (agent-comm-hub reachability plus per-peer online/queued/waiting/lastSeen, via a same-origin host route that calls the hub's read-only bridge_status MCP tool) and Chat room (a shared append-only JSONL log that several devices talk through; reads the latest lines and posts one directly). The chat log path and the speakers shown in that panel are configurable.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.0-rc.1"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "install.ps1",
    "enable.ps1",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node -e \"JSON.parse(require('fs').readFileSync('package.json','utf8'))\"",
    "test:config": "node test/config.test.mjs",
    "test:live": "node test/hub-fetch.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "agent-comm-hub",
    "sidebar"
  ]
}

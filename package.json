{
  "name": "dsh-hub-status",
  "version": "0.2.1",
  "description": "为 DeepSeek Harness 提供右侧栏的“Hub 状态”和“聊天室”两个页签：通过宿主同源接口只读查询 agent-comm-hub 的连通性、成员在线状态及队列；读取多设备共用的追加式 JSONL 聊天记录，并支持发送消息。聊天记录路径、说话人及署名均可配置。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.0-rc.1"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "scripts/pack-verified.mjs",
    "lib",
    "test",
    "cordis.patch.yml",
    "install.ps1",
    "enable.ps1",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node -e \"JSON.parse(require('fs').readFileSync('package.json','utf8'))\"",
    "test:config": "node test/config.test.mjs",
    "pack:verified": "node scripts/pack-verified.mjs",
    "test:live": "node test/hub-fetch.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "agent-comm-hub",
    "sidebar"
  ]
}
